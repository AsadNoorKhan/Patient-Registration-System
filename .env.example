# Copy to .env (never commit .env) — or set these in your hosting dashboard.
VAPI_SECRET=change-me-to-a-long-random-string   # must match the header configured in Vapi
DB_PATH=data/patients.db                        # on a host, point at a persistent volume, e.g. /data/patients.db
SEED_DEMO=false                                 # true = insert one demo patient on first start
